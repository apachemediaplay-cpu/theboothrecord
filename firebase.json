{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/og/**", "function": { "functionId": "ogImage", "region": "us-central1" } },
      { "source": "/v/**", "function": { "functionId": "share", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": [
      "node -e \"require('fs').copyFileSync('src/data/venues.json','functions/venues.json')\""
    ]
  }
}
