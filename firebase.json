{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/plead", "destination": "/confess?source=ig_comment", "type": 302 }
    ],
    "rewrites": [
      { "source": "/og/**", "function": { "functionId": "ogImage", "region": "us-central1" } },
      { "source": "/v/**", "function": { "functionId": "share", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "comment": "index.html must never be cached — it points at the fingerprinted bundle. A stale copy pins the browser to an old build (this is what hid the By-night section).",
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "comment": "Fingerprinted build assets are content-addressed — safe to cache forever.",
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": [
      "node scripts/copy-venues.mjs",
      "node scripts/copy-index-html.mjs"
    ]
  }
}
